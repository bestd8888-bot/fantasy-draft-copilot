{
  "manifest_version": 3,
  "name": "Fantasy Draft AI Copilot",
  "version": "1.1.0",
  "description": "Read-only Yahoo Fantasy Basketball draft room copilot: live 9-CAT recommendations, punt detection and roster fit.",
  "minimum_chrome_version": "114",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://basketball.fantasysports.yahoo.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options/index.html",
  "action": {
    "default_title": "Fantasy Draft AI Copilot",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://basketball.fantasysports.yahoo.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "file:///*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
